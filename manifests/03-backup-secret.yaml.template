# ----------------------------------------------------------------------------
# Demo CNPG PoC — Backup credentials TEMPLATE
#
# IMPORTANT: This is a *template*. Two options to materialize it:
#
# Option A (recommended) — Workload Identity (no secret with key needed):
#   1. Create a FederatedIdentityCredential binding the user-assigned MI
#      (created in infra/storage.bicep) to the ServiceAccount that CNPG uses
#      in namespace pg-demo (default: <cluster-name>).
#   2. Annotate the SA with:
#        azure.workload.identity/client-id: <backupIdentityClientId>
#   3. Reference the storage account in the Cluster CR via
#      `barmanObjectStore.azureCredentials.inheritFromAzureAD: true`.
#   4. Skip the password-based Secret entirely. The 03-backup-secret.yaml file
#      is then NOT applied.
#
# Option B (simpler, demo) — Storage Account Key as Secret:
#   1. Replace ${STORAGE_ACCOUNT} and ${STORAGE_ACCOUNT_KEY} with envsubst:
#        export STORAGE_ACCOUNT_KEY=$(az storage account keys list \
#            -g $RG_NAME -n $STORAGE_ACCOUNT --query [0].value -o tsv)
#        envsubst < manifests/03-backup-secret.yaml.template \
#            | kubectl apply -n pg-demo -f -
#   2. Reference it from Cluster CR via `azureCredentials.storageAccount` +
#      `azureCredentials.storageKey`.
#
# This file is consumed by scripts/01-bootstrap.sh in Option B path. Keep
# the rendered file out of git (.gitignore already excludes 03-backup-secret.yaml).
# ----------------------------------------------------------------------------
apiVersion: v1
kind: Secret
metadata:
  name: pg-backup-azure
  namespace: pg-demo
type: Opaque
stringData:
  AZURE_STORAGE_ACCOUNT: "${STORAGE_ACCOUNT}"
  AZURE_STORAGE_KEY: "${STORAGE_ACCOUNT_KEY}"
