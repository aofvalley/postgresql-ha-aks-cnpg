# ----------------------------------------------------------------------------
# Demo CNPG PoC — copia este archivo a `.env` y rellena los valores.
# Tenant demo: demo-admin@example.com
# Tenant ID:   00000000-0000-0000-0000-000000000000
# ----------------------------------------------------------------------------

# Azure
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
TENANT_ID=00000000-0000-0000-0000-000000000000
LOCATION=westeurope

# Resource group / naming (use the rg-pgha-demo- prefix convention)
RG_NAME=rg-pgha-demo
AKS_NAME=aks-pgha-demo
SECONDARY_AKS_NAME=aks-pgha-demo-2
STORAGE_ACCOUNT=stpghademo$RANDOM   # must be globally unique, lowercase, <=24 chars
LOG_ANALYTICS_NAME=law-demo-pgha

# Node pool sizing (optional — overrides Bicep defaults to fit within vCPU quota)
# Default Bicep: D8ds_v5 (system) + D16ds_v5 (user). Override for quota/cost:
SYSTEM_POOL_VM_SIZE=Standard_D4ds_v4
USER_POOL_VM_SIZE=Standard_D8ds_v5
SECONDARY_VM_SIZE=Standard_D4ds_v4

# CNPG
CNPG_NAMESPACE=cnpg-system
PG_NAMESPACE=pg-demo
CNPG_HELM_VERSION=0.22.1               # chart version that bundles CNPG operator 1.28.x
PG_CLUSTER_NAME=pg-demo
PG_VERSION_IMAGE=ghcr.io/cloudnative-pg/postgresql:16

# Backup container
BACKUP_CONTAINER=pg-backups

# ----------------------------------------------------------------------------
# Interop demo (script 14-demo-interop-bidir.sh)
# Bidirectional pg_dump/pg_restore between Flex Server (PaaS) and CNPG-on-AKS.
# ----------------------------------------------------------------------------
FLEX_FQDN=demo-flex-postgres.postgres.database.azure.com
FLEX_RG=rg-existing-flex
FLEX_SERVER=demo-flex-postgres
FLEX_AAD_ADMIN=demo-admin@example.com
INTEROP_DB=app_demo
INTEROP_BLOB_CONTAINER=interop-dumps     # only used by the optional WI Job (manifests/11-interop-job.yaml)
CNPG_LOCAL_PORT=5433                     # local port for kubectl port-forward to pg-demo-rw
